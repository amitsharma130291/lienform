---
import StatePage from '../layouts/StatePage.astro';
import SuccessDownloader from '../components/SuccessDownloader';
---

<StatePage
  title="Payment Successful — Downloading Your Lien Bundle | MechanicsLienForm"
  description="Your payment was successful. Your mechanics lien PDF bundle is downloading now."
  canonical="https://mechanicslienform.com/success/"
>
  <section class="max-w-2xl mx-auto px-4 py-16 text-center">

    <!-- PDF generation, email delivery, and status display -->
    <div class="mb-8">
      <SuccessDownloader client:load />
    </div>

    <p class="text-xs text-slate-400 mt-8">
      Not legal advice. Consult a licensed attorney in your state. 
      <a href="/contact/" class="underline">Contact support</a> with any questions.
    </p>
  </section>
</StatePage>
