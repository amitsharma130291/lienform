---
import StatePage from '../layouts/StatePage.astro';
import SuccessDownloader from '../components/SuccessDownloader';
---

<StatePage
  title="Payment Successful — Downloading Your Lien Bundle | MechanicsLienForm"
  description="Your payment was successful. Your mechanics lien PDF bundle is downloading now."
  canonical="https://mechanicslienform.com/success/"
>
  <section class="max-w-2xl mx-auto px-4 py-16 text-center">

    <!-- PDF generation, email delivery, and status display -->
    <div class="mb-8">
      <SuccessDownloader client:load />
    </div>

    <!-- What's in your bundle -->
    <div class="bg-slate-50 border border-slate-200 rounded-xl p-6 text-left mt-8">
      <h2 class="font-bold text-slate-800 mb-4">Your bundle includes:</h2>
      <ul class="space-y-2 text-sm text-slate-600">
        <li class="flex items-start gap-2"><span class="text-green-500 font-bold mt-0.5">✓</span> Page 1: Mechanics Lien Claim (state-specific, current statute)</li>
        <li class="flex items-start gap-2"><span class="text-green-500 font-bold mt-0.5">✓</span> Page 2: Deadline Confirmation with days remaining</li>
        <li class="flex items-start gap-2"><span class="text-green-500 font-bold mt-0.5">✓</span> Page 3: County Recorder filing instructions</li>
        <li class="flex items-start gap-2"><span class="text-green-500 font-bold mt-0.5">✓</span> Page 4: Proof of Service Affidavit</li>
        <li class="flex items-start gap-2"><span class="text-green-500 font-bold mt-0.5">✓</span> Page 5: Lien Release Form</li>
        <li class="flex items-start gap-2"><span class="text-green-500 font-bold mt-0.5">✓</span> Page 6: Preliminary Notice (if required for your state/role)</li>
      </ul>
    </div>

    <!-- Upsell: Annual Pass -->
    <div class="border border-blue-200 rounded-xl p-6 mt-6 text-left" style="background-color:#eff6ff;">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h3 class="font-bold text-lg mb-1" style="color:#1e2f6e;">File liens regularly?</h3>
          <p class="text-sm text-slate-600">Get unlimited lien bundles across all states for <strong>$89/year</strong> — that's less than 5 individual bundles.</p>
        </div>
        <a
          href="/pricing/"
          class="shrink-0 text-white text-sm font-semibold px-4 py-2 rounded-lg whitespace-nowrap"
          style="background-color:#2563eb;"
        >
          Learn More
        </a>
      </div>
    </div>

    <p class="text-xs text-slate-400 mt-8">
      Not legal advice. Consult a licensed attorney in your state. 
      <a href="/contact/" class="underline">Contact support</a> with any questions.
    </p>
  </section>
</StatePage>
