---
import StatePage from '../../layouts/StatePage.astro';
const title = "Contact LienForm";
const description = "Get in touch with the LienForm team. Questions about mechanics lien forms, filing deadlines, or the service.";
const pageUrl = Astro.url.href;
---

<StatePage title={title} description={description} canonical="https://mechanicslienform.com/contact/">
  <div class="max-w-2xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-navy-900 mb-3">Contact Us</h1>
    <p class="text-gray-600 mb-8">Have a question about mechanics liens, filing deadlines, or the LienForm service? Send us a message and we'll get back to you.</p>

    <div id="contact-success" class="hidden bg-green-50 border border-green-200 rounded-lg p-6 mb-6 text-center">
      <p class="text-green-800 font-semibold text-lg">✓ Message sent!</p>
      <p class="text-green-700 mt-1">Thank you — we'll get back to you shortly.</p>
    </div>

    <div id="contact-error" class="hidden bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
      <p class="text-red-700">Something went wrong. Please try again or email us directly at <a href="mailto:amitsharma00261@gmail.com" class="underline">amitsharma00261@gmail.com</a>.</p>
    </div>

    <form id="contact-form" class="space-y-5">
      <!-- Hidden field: page URL, invisible to user -->
      <input type="hidden" name="page_url" value={pageUrl} />

      <div>
        <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Name <span class="text-red-500">*</span></label>
        <input type="text" id="name" name="name" required
          class="block w-full px-4 py-2.5 rounded-lg border border-gray-300 text-gray-900 focus:outline-none focus:ring-2 focus:ring-navy-600 text-sm"
          placeholder="Your name" />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email <span class="text-red-500">*</span></label>
        <input type="email" id="email" name="email" required
          class="block w-full px-4 py-2.5 rounded-lg border border-gray-300 text-gray-900 focus:outline-none focus:ring-2 focus:ring-navy-600 text-sm"
          placeholder="you@company.com" />
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Message <span class="text-red-500">*</span></label>
        <textarea id="message" name="message" required rows="5"
          class="block w-full px-4 py-2.5 rounded-lg border border-gray-300 text-gray-900 focus:outline-none focus:ring-2 focus:ring-navy-600 text-sm resize-none"
          placeholder="Your question or message..."></textarea>
      </div>

      <button type="submit" id="submit-btn"
        class="w-full bg-navy-700 hover:bg-navy-800 text-white font-semibold py-3 px-8 rounded-lg transition-colors">
        Send Message
      </button>
    </form>
  </div>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const successEl = document.getElementById('contact-success')!;
    const errorEl = document.getElementById('contact-error')!;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.textContent = 'Sending...';
      submitBtn.disabled = true;
      errorEl.classList.add('hidden');

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          body: new FormData(form),
        });
        if (res.ok) {
          form.classList.add('hidden');
          successEl.classList.remove('hidden');
        } else {
          errorEl.classList.remove('hidden');
          submitBtn.textContent = 'Send Message';
          submitBtn.disabled = false;
        }
      } catch {
        errorEl.classList.remove('hidden');
        submitBtn.textContent = 'Send Message';
        submitBtn.disabled = false;
      }
    });
  </script>
</StatePage>
