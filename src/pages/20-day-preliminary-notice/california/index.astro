---
import StatePage from '../../../layouts/StatePage.astro';

const title = "How to Serve a 20-Day Preliminary Notice in California (Step-by-Step)";
const description = "Serve California's 20-day preliminary notice correctly or lose your lien rights. Exact steps, required content, deadlines, and a free form template — done right the first time.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the exact deadline for serving a California 20-day preliminary notice?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The notice must be served within 20 days of your first furnishing of labor, materials, or equipment on the project. If you started work on the 1st of the month, the notice must be postmarked by the 21st (day 20 from the 1st). Serving on day 20 is within the deadline; serving on day 21 is not."
      }
    },
    {
      "@type": "Question",
      "name": "Does serving the 20-day notice mean I have to file a lien?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. The preliminary notice is a prerequisite to filing a mechanics lien — it doesn't obligate you to file one. If you're paid in full, the notice simply sits in the file with no further action needed."
      }
    },
    {
      "@type": "Question",
      "name": "Can I email the preliminary notice instead of mailing it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "California law does not recognize email as a valid service method for the 20-day preliminary notice. You must use certified mail, personal service, or overnight delivery by an express carrier."
      }
    },
    {
      "@type": "Question",
      "name": "I forgot to serve the notice. Is all hope lost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Serve it today. Late service protects work done within 20 days before the service date. If you have unpaid work within that window, you still have lien rights for that work. Only work done more than 20 days before your late service is unprotected."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to serve a new notice if the project scope expands?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Generally no — one preliminary notice covers the entire project. If there's a long gap in your work followed by a new and distinct scope, re-serving is the safe approach. But for continuous work on the same project, one notice is sufficient."
      }
    },
    {
      "@type": "Question",
      "name": "What if the general contractor refuses to give me the owner's address?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Look it up yourself. The county assessor's database is public record and searchable by property address. The county recorder's office also has the deed showing the owner. Document your research. You can serve the 'reputed owner' based on your good-faith research."
      }
    },
    {
      "@type": "Question",
      "name": "Does the 20-day preliminary notice protect me if the GC goes bankrupt?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The preliminary notice protects your rights against the property — not the GC's estate. If the GC files bankruptcy, your mechanics lien runs against the property owner, not the bankrupt GC. This is precisely why the lien right (and the preliminary notice that preserves it) is so valuable: it gives you a direct claim against the real estate, separate from whatever happens to the GC financially."
      }
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
