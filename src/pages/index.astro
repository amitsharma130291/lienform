---
import StatePage from '../layouts/StatePage.astro';

const title = "MechanicsLienForm — Free Mechanics Lien Generator | Instant PDF Bundle";
const description = "Generate state-specific mechanics lien forms with role-aware deadlines, current law citations, and county recorder filing guides. No account required. Instant download after payment.";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "MechanicsLienForm",
  "url": "https://mechanicslienform.com",
  "description": "State-specific mechanics lien generator. Role-aware deadlines and current statutory citations. Instant download after payment. No account required."
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does MechanicsLienForm cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "MechanicsLienForm is $24.99 per document bundle. Download your complete lien bundle — lien claim, deadline confirmation, county recorder filing guide, proof of service affidavit, and lien release form — at $24.99 per document bundle."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to create an account to use MechanicsLienForm?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. MechanicsLienForm requires no account or login. Select your state, fill in your details, and download your PDF bundle immediately after payment."
      }
    },
    {
      "@type": "Question",
      "name": "Is MechanicsLienForm accurate for my state's current law?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. MechanicsLienForm uses current statutory citations: California Civil Code §8000–9566 (SB 189, 2019), Texas Property Code Ch. 53 (HB 2237, 2022), Michigan MCL 570.1101 (2023 amendments), and Florida Statute §713. We do not use outdated templates."
      }
    },
    {
      "@type": "Question",
      "name": "What does the PDF bundle include?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The complete bundle includes: (1) Mechanics lien claim with correct statutory citation, (2) Deadline confirmation with days remaining, (3) County recorder/clerk filing instructions, (4) Proof of service affidavit, (5) Lien release form, and (6) Preliminary Notice if required by your state and role."
      }
    },
    {
      "@type": "Question",
      "name": "What states does MechanicsLienForm cover?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "MechanicsLienForm currently generates forms for Michigan, California, Texas, and Florida (Notice to Owner). Additional states are being added weekly."
      }
    }
  ]
};

const schema = JSON.stringify([websiteSchema, faqSchema]);
---

<StatePage
  title={title}
  description={description}
  canonical="https://mechanicslienform.com/"
  schema={schema}
>
  <!-- Hero section -->
  <section class="bg-navy-900 text-white" style="background-color:#1e2f6e;">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
      <div class="max-w-3xl">
        <h1 class="text-4xl sm:text-5xl font-bold leading-tight mb-4">
          Generate Your Mechanics Lien Form in 3 Minutes
        </h1>
        <p class="text-xl text-blue-200 mb-8">
          State-specific mechanics lien documents — pre-filled with your project details, correct current statutory citations, and role-aware filing deadlines.
        </p>

        <!-- Benefit bullets -->
        <ul class="space-y-3 mb-8">
          <li class="flex items-start gap-3">
            <span class="text-green-400 mt-0.5 text-lg font-bold shrink-0">✓</span>
            <span class="text-blue-100"><strong class="text-white">Role-aware deadlines.</strong> The system knows whether your deadline is 30, 45, 90, or 180 days based on your role and state.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-green-400 mt-0.5 text-lg font-bold shrink-0">✓</span>
            <span class="text-blue-100"><strong class="text-white">Current law only.</strong> California forms cite §8000 (not the repealed §3082). Texas forms comply with HB 2237 (2022).</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-green-400 mt-0.5 text-lg font-bold shrink-0">✓</span>
            <span class="text-blue-100"><strong class="text-white">Complete bundle.</strong> Lien form + filing guide + deadline confirmation + proof of service affidavit + lien release. Everything in one download.</span>
