          >
            Get Started →
          </a>
          <p class="text-navy-300 text-sm self-center">Free deadline calculator — no payment required</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust bar -->
  <section class="bg-white border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex flex-wrap justify-center gap-x-8 gap-y-2 text-sm font-medium text-slate-600">
        <span class="flex items-center gap-2"><span class="text-green-500">✓</span> No account required</span>
        <span class="flex items-center gap-2"><span class="text-green-500">✓</span> Instant download</span>
        <span class="flex items-center gap-2"><span class="text-green-500">✓</span> Current statutory citations</span>
        <span class="flex items-center gap-2"><span class="text-green-500">✓</span> Role-aware deadlines</span>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-3xl font-bold text-navy-900 text-center mb-12">How It Works</h2>
    <div class="grid sm:grid-cols-3 gap-8">
      <div class="text-center">
        <div class="w-14 h-14 bg-navy-800 text-white rounded-2xl flex items-center justify-center text-2xl font-bold mx-auto mb-4">1</div>
        <h3 class="text-lg font-semibold text-navy-800 mb-2">Pick your state and role</h3>
        <p class="text-slate-600 text-sm">Choose your state from Michigan, California, Texas, or Florida. Select your role: GC, subcontractor, or supplier. LienForm loads the correct statutory framework automatically.</p>
      </div>
      <div class="text-center">
        <div class="w-14 h-14 bg-navy-800 text-white rounded-2xl flex items-center justify-center text-2xl font-bold mx-auto mb-4">2</div>
        <h3 class="text-lg font-semibold text-navy-800 mb-2">Fill in your project details</h3>
        <p class="text-slate-600 text-sm">Enter the property address, owner info, your company details, amount owed, and last furnishing date. The deadline calculator updates in real time as you type.</p>
