          </ul>
        </div>
        <div>
          <h4 class="font-semibold text-navy-300 text-xs uppercase tracking-wider mb-3">Legal</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/privacy/" class="text-navy-200 hover:text-white transition-colors">Privacy Policy</a></li>
            <li><a href="/terms/" class="text-navy-200 hover:text-white transition-colors">Terms of Service</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</StatePage>
