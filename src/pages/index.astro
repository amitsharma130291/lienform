---
import StatePage from '../layouts/StatePage.astro';

const title = "LienForm — Free Mechanics Lien Generator | $24.99 PDF Bundle";
const description = "Generate state-specific mechanics lien forms with role-aware deadlines, current law citations, and county recorder filing guides. $24.99. No account required. Instant download.";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "LienForm",
  "url": "https://lienform.com",
  "description": "Free mechanics lien generator. State-specific forms with role-aware deadlines and current statutory citations. $24.99 PDF bundle. No account required."
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does LienForm cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$24.99 for a complete lien bundle including the lien claim, deadline confirmation, county recorder filing guide, proof of service affidavit, and lien release form. Ancillary documents (Lien Waiver, Notice of Intent, Lien Release) available separately at $9.99–$14.99."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to create an account to use LienForm?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. LienForm requires no account or login. Select your state, fill in your details, pay $24.99, and download your PDF bundle immediately."
      }
    },
    {
      "@type": "Question",
      "name": "Is LienForm accurate for my state's current law?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. LienForm uses current statutory citations: California Civil Code §8000–9566 (SB 189, 2019), Texas Property Code Ch. 53 (HB 2237, 2022), Michigan MCL 570.1101 (2023 amendments), and Florida Statute §713. We do not use outdated templates."
      }
    },
    {
      "@type": "Question",
      "name": "What does the $24.99 PDF bundle include?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The complete bundle includes: (1) Mechanics lien claim with correct statutory citation, (2) Deadline confirmation with days remaining, (3) County recorder/clerk filing instructions, (4) Proof of service affidavit, (5) Lien release form, and (6) Preliminary Notice if required by your state and role."
      }
    },
    {
      "@type": "Question",
      "name": "What states does LienForm cover?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "LienForm currently generates forms for Michigan, California, Texas, and Florida (Notice to Owner). Additional states are being added weekly."
      }
    }
  ]
};

const schema = JSON.stringify([websiteSchema, faqSchema]);
---

<StatePage
  title={title}
  description={description}
  canonical="https://lienform.com/"
  schema={schema}
>
  <!-- Hero section -->
  <section class="bg-navy-900 text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
      <div class="max-w-3xl">
        <h1 class="text-4xl sm:text-5xl font-bold leading-tight mb-4">
          Generate Your Mechanics Lien Form in 3 Minutes
        </h1>
        <p class="text-xl text-navy-200 mb-8">
          State-specific mechanics lien documents — pre-filled with your project details, correct current statutory citations, and role-aware filing deadlines.
        </p>

        <!-- Benefit bullets -->
        <ul class="space-y-3 mb-8">
          <li class="flex items-start gap-3">
            <span class="text-green-400 mt-0.5 text-lg font-bold shrink-0">✓</span>
            <span class="text-navy-100"><strong class="text-white">Role-aware deadlines.</strong> The system knows whether your deadline is 30, 45, 90, or 180 days based on your role and state.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-green-400 mt-0.5 text-lg font-bold shrink-0">✓</span>
            <span class="text-navy-100"><strong class="text-white">Current law only.</strong> California forms cite §8000 (not the repealed §3082). Texas forms comply with HB 2237 (2022).</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-green-400 mt-0.5 text-lg font-bold shrink-0">✓</span>
            <span class="text-navy-100"><strong class="text-white">Complete bundle.</strong> Lien form + filing guide + deadline confirmation + proof of service affidavit + lien release. Everything in one download.</span>
