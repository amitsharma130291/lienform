      <p class="text-slate-600 text-center mb-10">Select your state to start generating your lien form now.</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Michigan -->
        <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
          <h3 class="font-bold text-navy-800 text-lg mb-1">Michigan</h3>
          <p class="text-xs text-slate-500 mb-2">MCL 570.1101–570.1305 (2023)</p>
          <p class="text-sm text-slate-600 mb-4">Mechanics lien for construction projects. 90-day residential / 180-day commercial deadline.</p>
          <div class="flex items-center justify-between">
            <span class="text-lg font-bold text-navy-800">$24.99</span>
            <a href="/mechanics-lien/michigan/" class="bg-navy-700 text-white text-sm font-medium px-4 py-2 rounded-lg hover:bg-navy-800 transition-colors">Generate →</a>
          </div>
        </div>

        <!-- Florida NTO -->
        <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
          <h3 class="font-bold text-navy-800 text-lg mb-1">Florida (NTO)</h3>
          <p class="text-xs text-slate-500 mb-2">Fla. Stat. §713.06</p>
          <p class="text-sm text-slate-600 mb-4">Notice to Owner required within 45 days of first furnishing. Prerequisite to filing a lien.</p>
          <div class="flex items-center justify-between">
            <span class="text-lg font-bold text-navy-800">$14.99</span>
            <a href="/notice-to-owner/florida/" class="bg-navy-700 text-white text-sm font-medium px-4 py-2 rounded-lg hover:bg-navy-800 transition-colors">Generate →</a>
          </div>
        </div>

        <!-- California -->
        <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
          <h3 class="font-bold text-navy-800 text-lg mb-1">California</h3>
          <p class="text-xs text-slate-500 mb-2">Civil Code §8000–9566 (SB 189)</p>
          <p class="text-sm text-slate-600 mb-4">Current statute only — §3082 is repealed. 20-day prelim notice for subs. 90-day lien deadline.</p>
          <div class="flex items-center justify-between">
            <span class="text-lg font-bold text-navy-800">$24.99</span>
            <a href="/mechanics-lien/california/" class="bg-navy-700 text-white text-sm font-medium px-4 py-2 rounded-lg hover:bg-navy-800 transition-colors">Generate →</a>
          </div>
        </div>

        <!-- Texas -->
        <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
