      </div>
    </div>
  </section>

  <!-- Homepage footer links (above the layout footer) -->
  <section style="background-color:#1e2f6e;" class="text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="grid sm:grid-cols-3 gap-8">
        <div>
          <h4 class="font-semibold text-blue-300 text-xs uppercase tracking-wider mb-3">State Forms</h4>
