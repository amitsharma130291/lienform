            "Mechanics lien claim form",
            "Deadline confirmation with days remaining",
            "County recorder/clerk filing guide",
            "Proof of service affidavit",
            "Lien release form",
            "Preliminary Notice (if required for your state/role)"
          ].map((item) => (
            <div class="flex items-start gap-2 text-sm">
              <span class="text-green-400 shrink-0">✓</span>
              <span class="text-navy-100">{item}</span>
            </div>
          ))}
        </div>
        <a href="/mechanics-lien/" class="inline-flex items-center gap-2 bg-white text-navy-800 font-bold px-6 py-3 rounded-xl hover:bg-navy-50 transition-colors">
          Get Started →
        </a>
      </div>

      <!-- Ancillary -->
      <div class="space-y-4">
        <div class="bg-white border border-slate-200 rounded-xl p-5">
          <div class="flex items-center justify-between mb-1">
            <h4 class="font-semibold text-navy-800">Florida Notice to Owner</h4>
            <span class="text-lg font-bold text-navy-800">$14.99</span>
          </div>
          <p class="text-sm text-slate-500">NTO form · 45-day deadline calculator · Proof of service</p>
        </div>

        <div class="bg-white border border-slate-200 rounded-xl p-5">
          <h4 class="font-semibold text-navy-700 text-sm mb-3">Ancillary Documents — $9.99 each</h4>
          <ul class="space-y-1.5 text-sm text-slate-600">
            <li class="flex items-center gap-2"><span class="text-slate-400">·</span> Lien Waiver (Conditional or Unconditional)</li>
            <li class="flex items-center gap-2"><span class="text-slate-400">·</span> Notice of Intent to Lien</li>
            <li class="flex items-center gap-2"><span class="text-slate-400">·</span> Lien Release / Discharge of Lien</li>
            <li class="flex items-center gap-2"><span class="text-slate-400">·</span> Preliminary Notice — $14.99</li>
          </ul>
          <p class="text-xs text-slate-400 mt-3">Coming soon — notify me when available</p>
