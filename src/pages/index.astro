          <div class="flex items-center justify-between">
            <span class="text-lg font-bold" style="color:#1e2f6e;">$24.99</span>
            <a href="/mechanics-lien/texas/" class="text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors" style="background-color:#1e4bc2;">Generate →</a>
