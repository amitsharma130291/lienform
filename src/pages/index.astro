            LienForm currently generates forms for Michigan, California, Texas, and Florida (Notice to Owner). Additional states are being added weekly.
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Homepage footer links (above the layout footer) -->
  <section class="bg-navy-900 text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="grid sm:grid-cols-3 gap-8">
        <div>
          <h4 class="font-semibold text-navy-300 text-xs uppercase tracking-wider mb-3">State Forms</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/mechanics-lien/michigan/" class="text-navy-200 hover:text-white transition-colors">Michigan Mechanics Lien</a></li>
            <li><a href="/mechanics-lien/california/" class="text-navy-200 hover:text-white transition-colors">California Mechanics Lien</a></li>
            <li><a href="/mechanics-lien/texas/" class="text-navy-200 hover:text-white transition-colors">Texas Mechanics Lien</a></li>
            <li><a href="/notice-to-owner/florida/" class="text-navy-200 hover:text-white transition-colors">Florida Notice to Owner</a></li>
