            style="color:#1e2f6e;"
          >
            Generate Your Lien Form →
          </a>
          <p class="text-blue-300 text-sm self-center">Free deadline calculator — no payment required</p>
        </div>
        <p class="text-sm text-blue-200 mt-3 opacity-80">
        </p>
      </div>
    </div>
  </section>

  <!-- Trust bar -->
  <section class="bg-white border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex flex-wrap justify-center gap-x-8 gap-y-2 text-sm font-medium text-slate-600">
        <span class="flex items-center gap-2"><span class="text-green-500">✓</span> Instant Download</span>
        <span class="flex items-center gap-2"><span class="text-green-500">✓</span> No account required</span>
        <span class="flex items-center gap-2"><span class="text-green-500">✓</span> Instant download</span>
        <span class="flex items-center gap-2"><span class="text-green-500">✓</span> Current statutory citations</span>
