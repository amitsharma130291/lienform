          <p class="text-sm text-slate-600 mb-4">Construction real property lien. Monthly notices for residential subs. GC: 4th month 15th.</p>
          <div class="flex items-center justify-between">
            <span class="text-lg font-bold text-navy-800">$24.99</span>
            <a href="/mechanics-lien/texas/" class="bg-navy-700 text-white text-sm font-medium px-4 py-2 rounded-lg hover:bg-navy-800 transition-colors">Generate →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
