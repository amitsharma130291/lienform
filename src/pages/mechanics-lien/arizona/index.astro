    {
      "@type": "HowToStep",
      "name": "Record and serve the Notice and Claim of Lien",
      "text": "Record with the county recorder where the property is located, then serve the owner within a reasonable time and calendar the six-month foreclosure deadline under A.R.S. § 33-998."
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mechanicslienform.com" },
    { "@type": "ListItem", "position": 2, "name": "Mechanics Lien", "item": "https://mechanicslienform.com/mechanics-lien/" },
    { "@type": "ListItem", "position": 3, "name": "Arizona", "item": "https://mechanicslienform.com/mechanics-lien/arizona/" }
