const description = "Learn Arizona's preliminary 20-day notice, mechanics lien filing deadline, required attachments, service, completion rules, and six-month foreclosure period.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What does an Arizona 20-day notice do?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It preserves the right to include protected furnishing in a later lien claim. Serving it does not place a recorded debt against the property."
      }
    },
    {
      "@type": "Question",
      "name": "Can I serve the preliminary notice before starting work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. The statutory notice can be served before furnishing begins, which avoids a rushed calculation after mobilization."
      }
    },
    {
      "@type": "Question",
      "name": "When does the 60-day deadline replace the 120-day deadline?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The 60-day period generally applies after the owner records a Notice of Completion. Without that recorded notice, the ordinary period is 120 days after statutory completion."
      }
    },
    {
      "@type": "Question",
      "name": "Where is the lien recorded?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "With the county recorder in the Arizona county where the property, or part of it, is located."
      }
    },
    {
      "@type": "Question",
      "name": "How long do I have to enforce it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Arizona's general foreclosure period is six months after the lien is recorded. Filing the lien does not pause that deadline while the parties negotiate."
      }
    }
  ]
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to File an Arizona Mechanics Lien",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Confirm completion and any Notice of Completion",
      "text": "Determine statutory completion under A.R.S. § 33-993 and search county records for a recorded Notice of Completion, which shortens the recording period from 120 to 60 days."
