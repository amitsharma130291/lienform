---
import StatePage from '../../layouts/StatePage.astro';

const title = "Mechanics Lien Forms — Free State-by-State Generator | LienForm";
const description = "Generate mechanics lien forms for all 50 states. Role-aware deadline calculator, current statutory citations, county recorder guide. 100% free. No account required.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is a mechanics lien?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A mechanics lien (also called a construction lien, materialman's lien, or contractor's lien) is a legal security interest in real property granted to contractors, subcontractors, laborers, and material suppliers who have contributed to the improvement of the property and have not been fully paid."
      }
    },
    {
      "@type": "Question",
      "name": "Who can file a mechanics lien?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "General contractors, subcontractors, sub-subcontractors, material suppliers, equipment rental companies, architects, and engineers — anyone who has contributed labor, materials, or services to a construction project. Specific eligibility varies by state."
      }
    },
    {
      "@type": "Question",
      "name": "How does filing a mechanics lien help me get paid?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A recorded mechanics lien attaches to the property title. The owner cannot sell or refinance the property with an active lien on title. This gives claimants significant leverage to negotiate payment without going to court."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between a preliminary notice and a mechanics lien?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A preliminary notice (also called a pre-lien notice or notice to owner) must be served early — typically within 20-45 days of starting work — as a condition of preserving lien rights. The mechanics lien itself is recorded later, after non-payment. The preliminary notice is the prerequisite; the lien is the remedy."
      }
    },
    {
      "@type": "Question",
      "name": "What happens after I file a mechanics lien?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "After recording, you typically must serve a copy on the owner. If still unpaid, you must file a lawsuit to enforce the lien (foreclose) within a state-specific deadline (often 90 days to 1 year after recording). Most liens get resolved through payment before foreclosure."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need an attorney to file a mechanics lien?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most states do not require an attorney to record a mechanics lien. However, enforcement (foreclosure) typically requires court action and legal representation. LienForm generates the lien document; consult an attorney for disputes."
      }
    },
    {
      "@type": "Question",
      "name": "Which states have the strongest mechanics lien laws?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "California, Texas, Florida, and Michigan have well-developed mechanics lien statutes with clear deadlines and procedures. California's SB 189 (2012) is considered a model statute. Texas's HB 2237 (2022) significantly clarified the monthly notice requirements."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between a mechanics lien and a UCC filing?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A mechanics lien attaches to real property (land, buildings). A UCC (Uniform Commercial Code) filing attaches to personal property, equipment, or business assets. For construction disputes over real property, a mechanics lien is the correct remedy."
      }
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://lienform.com" },
    { "@type": "ListItem", "position": 2, "name": "Mechanics Lien", "item": "https://lienform.com/mechanics-lien/" }
  ]
};

const schema = JSON.stringify([faqSchema, breadcrumbSchema]);

const activeStates = [
  { name: "Michigan", slug: "michigan", stat: "MCL 570.1101–570.1305", deadline: "90/180 days" },
  { name: "California", slug: "california", stat: "Civil Code §8000–9566", deadline: "90 days" },
  { name: "Texas", slug: "texas", stat: "Tex. Prop. Code Ch. 53", deadline: "4th month 15th" },
];

const comingSoonStates = [
  "Alabama", "Alaska", "Arizona", "Arkansas", "Colorado", "Connecticut",
  "Delaware", "Florida", "Georgia", "Hawaii", "Idaho", "Illinois",
  "Indiana", "Iowa", "Kansas", "Kentucky", "Louisiana", "Maine",
  "Maryland", "Massachusetts", "Minnesota", "Mississippi", "Missouri",
  "Montana", "Nebraska", "Nevada", "New Hampshire", "New Jersey",
  "New Mexico", "New York", "North Carolina", "North Dakota", "Ohio",
  "Oklahoma", "Oregon", "Pennsylvania", "Rhode Island", "South Carolina",
  "South Dakota", "Tennessee", "Utah", "Vermont", "Virginia",
  "Washington", "West Virginia", "Wisconsin", "Wyoming"
];

const docTypes = [
  { name: "Mechanics Lien Claim", href: "/mechanics-lien/", active: true, desc: "Record a lien against real property to secure payment" },
  { name: "Preliminary Notice", href: "/preliminary-notice/", active: false, desc: "Pre-lien notice required before filing in most states" },
  { name: "Notice to Owner", href: "/notice-to-owner/florida/", active: true, desc: "Florida NTO required within 45 days of first furnishing" },
  { name: "Notice of Furnishing", href: "/notice-of-furnishing/", active: false, desc: "Michigan notice required for subs and suppliers" },
  { name: "Lien Waiver", href: "/lien-waiver/", active: false, desc: "Release lien rights upon receipt of payment" },
  { name: "Lien Release", href: "/lien-release/", active: false, desc: "Discharge a recorded lien after payment" },
  { name: "Notice of Intent", href: "/notice-of-intent/", active: false, desc: "Final warning before recording a mechanics lien" },
