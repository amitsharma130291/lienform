const title = "Mechanics Lien Release: How to Remove a Lien (and When Not To)";
const description = "A mechanics lien release removes a filed lien from property records. Learn when to release, how to do it by state, and how to protect yourself as a contractor.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
