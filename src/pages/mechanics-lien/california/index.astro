    {
      "@type": "Question",
      "name": "Do I need a Preliminary Notice before filing a California mechanics lien?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, if you are a subcontractor, material supplier, or anyone without a direct contract with the owner. You must serve a 20-day Preliminary Notice (Civ. Code §8200) within 20 days of first furnishing. Without it, your lien rights are limited to work done in the 20 days before you served it."
      }
    },
    {
      "@type": "Question",
      "name": "What is the deadline to file a California mechanics lien?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "90 days after the completion of the work of improvement, or 90 days after cessation of labor if the project was not completed. For direct contractors, the 90-day period begins when the owner records a Notice of Completion or 60 days after completion if no notice is recorded."
      }
    },
    {
      "@type": "Question",
      "name": "Where do I record a California mechanics lien?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "With the county recorder in the county where the property is located. Recording fees are approximately $15–$25 per page."
      }
