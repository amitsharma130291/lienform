    <h1 class="text-4xl font-bold text-navy-900 mb-4">California Mechanics Lien Form</h1>

    <!-- Preliminary Notice banner — shown for subcontractors/material suppliers -->
    <div id="preliminary-notice-banner" class="hidden bg-trust-green text-white p-4 rounded-lg mb-4">
      ✓ Your bundle automatically includes the 20-Day Preliminary Notice (Civ. Code §8200) — required for subcontractors and material suppliers.
    </div>

    <script>
      // Show preliminary notice banner when role is subcontractor or material-supplier
      (function () {
        function updateBanner() {
          const roleInputs = document.querySelectorAll('input[name="role"], select[name="role"]');
          const banner = document.getElementById('preliminary-notice-banner');
          if (!banner) return;
          roleInputs.forEach(function (el) {
            el.addEventListener('change', function () {
              const val = el.value || '';
