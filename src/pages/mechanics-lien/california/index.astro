    {
      "@type": "Question",
      "name": "Do I need to serve the owner after recording a California mechanics lien?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Under Civ. Code §8416, you must serve a copy of the recorded lien on the owner within 15 days of recording. Failure to serve can invalidate the lien."
      }
    },
