---
import StatePage from './StatePage.astro';
import PaidProductCard from '../components/PaidProductCard.astro';
interface Props {
  name: string; slug: string; title: string; description: string; heading: string;
  summary: string; faqs: { question: string; answer: string }[];
  sources: { title: string; url: string }[];
}
const { name, slug, title, description, heading, summary, faqs, sources } = Astro.props;
const canonical = `https://mechanicslienform.com/mechanics-lien/${slug}/`;
const schema = JSON.stringify([
  { '@context': 'https://schema.org', '@type': 'Article', headline: heading, description, mainEntityOfPage: canonical, author: { '@type': 'Organization', name: 'MechanicsLienForm', url: 'https://mechanicslienform.com/about/' }, publisher: { '@type': 'Organization', name: 'MechanicsLienForm', url: 'https://mechanicslienform.com/' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://mechanicslienform.com/' },
    { '@type': 'ListItem', position: 2, name: 'Mechanics lien guides', item: 'https://mechanicslienform.com/mechanics-lien/' },
    { '@type': 'ListItem', position: 3, name, item: canonical },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) },
]);
---
<StatePage title={title} description={description} canonical={canonical} schema={schema}>
  <article class="mx-auto max-w-4xl px-4 py-8 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-slate-600"><a href="/" class="underline">Home</a> › <a href="/mechanics-lien/" class="underline">Mechanics lien guides</a> › <span aria-current="page">{name}</span></nav>
    <h1 class="text-3xl font-bold leading-tight text-navy-900 sm:text-4xl">{heading}</h1>
    <p class="my-6 rounded-xl border-l-4 border-navy-600 bg-navy-50 p-5 text-lg text-navy-900">{summary}</p>
    <p class="mb-6 text-sm text-slate-600">Read the filing guide below, or <a class="font-semibold underline text-navy-700" href="#paid-tools">see available paid PDF tools and state coverage</a>.</p>
    <div class="prose prose-lg max-w-none prose-headings:scroll-mt-24 prose-a:text-navy-700">
      <slot />
      <PaidProductCard stateName={name} florida={slug === 'florida'} />
      <h2 id="faq">{name} mechanics lien questions</h2>
      {faqs.map(f => <details class="rounded-lg border border-slate-200 px-5"><summary class="cursor-pointer py-4 font-semibold">{f.question}</summary><p class="pb-4">{f.answer}</p></details>)}
      <h2>Official sources and verification</h2>
      <p>Sources checked September 18, 2026. This guide explains general private-project rules; it does not establish eligibility or provide legal advice. Check amendments, the applicable contract date, and local filing procedures before acting. A licensed {name} construction attorney should review disputed dates, missed notices, bankruptcy, public work, or contested amounts.</p>
      <ul>{sources.map(s => <li><a href={s.url} rel="noopener" target="_blank">{s.title}</a></li>)}</ul>
    </div>
  </article>
</StatePage>
