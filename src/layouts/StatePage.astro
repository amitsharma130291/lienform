---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  schema?: string; // JSON-LD string
}

const {
  title,
  description,
  canonical,
  ogTitle,
  ogDescription,
  schema,
} = Astro.props;

const canonicalUrl = canonical || Astro.url.href;
const resolvedOgTitle = ogTitle || title;
const resolvedOgDescription = ogDescription || description;

const GA_ID = 'G-H68Z9GWZ12';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <title>{title}</title>

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MechanicsLienForm" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={resolvedOgDescription} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.svg" />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Google Analytics 4 -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', GA_ID, {
        page_path: window.location.pathname,
      });
    </script>

    <!-- JSON-LD Structured Data -->
    {schema && (
      <script type="application/ld+json" set:html={schema} />
    )}
  </head>

  <body class="min-h-screen flex flex-col bg-white font-sans antialiased">
    <!-- Global Navigation -->
    <header class="sticky top-0 z-50 bg-white border-b border-slate-200 shadow-sm">
      <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between" style="height:80px;">
        <!-- Logo -->
        <a href="/" class="flex items-center hover:opacity-90 transition-opacity">
          <img
            src="/logo.svg"
            alt="MechanicsLienForm — Free Mechanics Lien Generator"
            style="height:60px; width:auto; display:block;"
          />
        </a>

        <!-- Nav Links -->
        <div class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600">
          <a href="/mechanics-lien/" class="hover:text-[#1e2f6e] transition-colors">Mechanics Lien</a>
          <a href="/notice-to-owner/florida/" class="hover:text-[#1e2f6e] transition-colors">Notice to Owner</a>
          <a href="/mechanics-lien/" class="hover:text-[#1e2f6e] transition-colors">All States</a>
          <a href="/contact/" class="hover:text-[#1e2f6e] transition-colors">Contact</a>
        </div>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-toggle"
          class="md:hidden p-2 rounded-lg text-slate-600 hover:bg-slate-100"
          aria-label="Toggle menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </nav>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-slate-100 bg-white px-4 py-3 space-y-2">
        <a href="/mechanics-lien/" class="block py-2 text-sm font-medium text-slate-700 hover:text-[#1e2f6e]">Mechanics Lien</a>
        <a href="/notice-to-owner/florida/" class="block py-2 text-sm font-medium text-slate-700 hover:text-[#1e2f6e]">Notice to Owner</a>
        <a href="/mechanics-lien/" class="block py-2 text-sm font-medium text-slate-700 hover:text-[#1e2f6e]">All States</a>
        <a href="/contact/" class="block py-2 text-sm font-medium text-slate-700 hover:text-[#1e2f6e]">Contact</a>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-50 border-t border-slate-200 mt-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex flex-wrap gap-4 justify-center mb-4 text-sm">
          <a href="/about/" class="text-slate-500 hover:text-slate-700 transition-colors">About</a>
          <a href="/contact/" class="text-slate-500 hover:text-slate-700 transition-colors">Contact</a>
          <a href="/privacy-policy/" class="text-slate-500 hover:text-slate-700 transition-colors">Privacy Policy</a>
          <a href="/terms-of-service/" class="text-slate-500 hover:text-slate-700 transition-colors">Terms of Service</a>
        </div>
        <div class="flex flex-col md:flex-row items-center justify-between gap-4">
          <p class="text-sm text-slate-500 text-center md:text-left">
            &copy; 2024 MechanicsLienForm.com &mdash; This form is provided for informational purposes only.
            Not legal advice. Consult a licensed attorney in your state.
          </p>
          <div class="flex items-center gap-4 text-xs text-slate-400">
            <a href="/privacy-policy/" class="hover:text-slate-600 transition-colors">Privacy</a>
            <a href="/terms-of-service/" class="hover:text-slate-600 transition-colors">Terms</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile menu toggle script -->
    <script>
      const toggle = document.getElementById('mobile-menu-toggle');
      const menu = document.getElementById('mobile-menu');
      if (toggle && menu) {
        toggle.addEventListener('click', () => {
          menu.classList.toggle('hidden');
        });
      }
    </script>
  </body>
</html>
